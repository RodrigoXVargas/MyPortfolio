---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/LayoutDev.astro';
import LinkedInIcon from '../components/icons/LinkedIn.astro';
import GithubIcon from '../components/icons/Github.astro';
import MailIcon from '../components/icons/Mail.astro';
import SuitCaseIcon from '../components/icons/SuitCase.astro';
import CodeIcon from '../components/icons/Code.astro';
import FileDownloadIcon from '../components/icons/FileDownload.astro';
import SocialPill from '../components/SocialPill.astro'
import SectionContainer from '../components/SectionContainer.astro';
import NavIcons from '../components/NavIcons.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Educacion from '../components/Educacion.astro';
---

<Layout
	title="Porfolio de Rodrigo Vargas - Soporte IT y Helpdesk"
	description='Porfolio de presentación para contratar a Rodrigo Vargas como Soporte IT o Helpdesk'
	foto='/fotos/perfil Rodrigo Vargas.jpg'
	titleA='Programador'
>
	<main class="px-4">
		<SectionContainer id="about" class="pt-40 pb-32 scroll-mt-20">
			<!-- <img 
				class="rounded-full size-40 mb-4"
				src="/fotos/perfil Rodrigo Vargas.jpg" 
				alt="mi foto"
			/> -->
			<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flew-row gap-x-4 pb-6 lg:pb-10">
				Hola, soy Rodrigo <a
				href="https://www.linkedin.com/in/rodrigoxvargas/"
				target="_blank"
				rel="noopener"
				class="flex justify-center items-center"
				>
					<Badge>Disponible para trabajar</Badge>
				</a>
			</h1>
			<h2 class="text-sm lg:text-xl text-wrap max-w-[700px] mb-8" >
				<span class="text-yellow-200" >Soporte IT / Helpdesk. </span>Profesional con 4 años de experiencia en soporte técnico, especializado en la resolución de problemas de hardware, software y administración de sistemas, tanto de forma remota como presencial.
			</h2>
			
			<NavIcons>
				<SocialPill href="https://www.linkedin.com/in/rodrigoxvargas">
					<LinkedInIcon class="size-4 md:size-6"/>
					LinkedIn
				</SocialPill>

				<SocialPill href="https://github.com/RodrigoXVargas">
					<GithubIcon class="size-4 md:size-6"/>
					Github
				</SocialPill>

				<SocialPill href="mailto:rxvargas.92@gmail.com">
					<MailIcon class="size-4 md:size-6"/>
					rxvargas.92@gmail.com
				</SocialPill>

				<SocialPill href="/cvs/Rodrigo Vargas CV.pdf" download="Rodrigo Vargas CV.pdf">
					<FileDownloadIcon class="size-4 md:size-6"/>
					CV
				</SocialPill>
			</NavIcons>
		</SectionContainer>
		<SectionContainer id="experiencia" class="scroll-mt-20">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<SuitCaseIcon class="size-7"/>
				Experiencia Laboral
			</h2>
			<Experience programador={false} soporte={true}/>
		</SectionContainer>

		<SectionContainer id="educacion" class="scroll-mt-20 mt-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<SuitCaseIcon class="size-7"/>
				Educación
			</h2>
			<Educacion/>
		</SectionContainer>

	</main>
</Layout>

