---
import Badge from '../components/Badge.astro';
import Layout from '../layouts/LayoutDev.astro';
import SuitCaseIcon from '../components/icons/SuitCase.astro';
import CodeIcon from '../components/icons/Code.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Educacion from '../components/Educacion.astro';
import Certificados from '../components/Certificados.astro';
import Cert from '../components/icons/Cert.astro';
import ModalCert from '../components/ModalCert';
---

<Layout
	title="Porfolio de Rodrigo Vargas - Desarrollador y Programador Backend"
	description='Porfolio de presentación para contratar a Rodrigo Vargas como desarrollador o programador'
	foto='/fotos/perfil Rodrigo Vargas gris.jpg'
	titleA='Soporte'
>
	<main class="">
		<SectionContainer id="about" class="pt-60 pb-52 scroll-mt-20 flex justify-center">
			<section class="flex items-center">
				<img 
					class="rounded-full size-40 mb-4"
					src="/fotos/perfil Rodrigo Vargas gris.jpg" 
					alt="mi foto"
				/>
				<span class="pl-5">
					<span class="flex items-center pb-5">
						<h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flew-row gap-x-4">
							Hola, soy Rodrigo 
						</h1>
						<a
						href="https://www.linkedin.com/in/rodrigoxvargas/"
						target="_blank"
						rel="noopener"
						class="flex justify-center items-center pl-4"
						>
							<Badge>
								Más sobre mi
							</Badge>
						</a>
					</span>
					<h2 class="text-base lg:text-base text-wrap max-w-[700px] mb-8" >
						<span class="text-yellow-200" >Desarrollador Backend </span>con sólidos conocimientos en Java, Spring y otras tecnologías. Enfocado en construir APIs claras, eficientes y mantenibles, con atención a la arquitectura y escalabilidad.
					</h2>
				</span>
				
			</section>
		</SectionContainer>

		<SectionContainer id="experiencia" class="scroll-mt-20 flex items-center justify-center">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<SuitCaseIcon class="size-7"/>
				Experiencia Laboral
			</h2>
			<Experience/>
		</SectionContainer>
		
		<SectionContainer id="educacion" class="scroll-mt-20 mt-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<SuitCaseIcon class="size-7"/>
				Educación
			</h2>
			<Educacion/>
		</SectionContainer>

		<SectionContainer id="proyectos" class="scroll-mt-20 mt-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size-7"/>
				Proyectos
			</h2>
			<Projects/>
		</SectionContainer>

		<SectionContainer id="certificados" class="mt-24">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center justify-center">
				<Cert class="size-7"/>
				Certificados y Cursos
			</h2>
			<Certificados/>
		</SectionContainer>
		
	</main>
</Layout>

