---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '@fontsource-variable/onest';
import '../styles/global.css';

interface Props {
	title: string;
	description: string
	foto: string
	titleA: string
}

const { description, title, foto, titleA } = Astro.props;
const color = titleA==="Soporte" ? "5e5e5e": "7e0303"
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="facebook-domain-verification" content="55wjn0xky4wokxlssqu177kn8jrs5f" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={foto} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body id="top" class="bg-[#031A29] mx-10">
		<!-- <div class="absolute top-0 z-[-2] h-screen w-screen" 
		style={`background: radial-gradient(ellipse 80% 80% at 50% -20%, #${color}, rgba(255, 255, 255, 0))`}></div> -->
		<Header titleA={titleA}/>
		<slot />
		<Footer color={color}/>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
	}
	html {
		font-family: "Onest Variable", system-ui, sans-serif;
		scroll-behavior: smooth;
	}
	
	body {
		background: #0a0a0a;
		display: flex;
		flex-direction: column;
		height: 100vh;
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	/* src/styles/global.css */
.no-scrollbar {
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* Internet Explorer 10+ */
}
.no-scrollbar::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

</style>
