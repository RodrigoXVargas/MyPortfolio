---
import ExperienceItem from "./ExperienceItem.astro"
import PythonIcon from './icons/Python.astro'
import DjangoIcon from './icons/Django.astro'
import JavascriptIcon from './icons/Javascript.astro'
import TypescriptIcon from './icons/Typescript.astro'
import ExpressIcon from './icons/Express.astro'
import SequelizeIcon from './icons/Sequelize.astro'
import PostgreSQLIcon from './icons/PostgreSQL.astro'

const EXPERIENCESOPORTE = [
  {
    date: "Agosto 2023 - Actualidad",
    title: "KONECTA: Soporte IT / Helpdesk (Presencial)",
    description: "Soporte técnico presencial, resolución de incidencias de conectividad y software. Gestión de tickets e instalación de equipos y software. Gestión de inventario/stock",
    techs: null
  },  
  {
    date: "Abril 2020 - Agosto 2023",
    title: "KONECTA: Soporte IT / Helpdesk (Remoto)",
    description: "Soporte técnico remoto para empleados, implementando soluciones de seguridad y acceso remoto. Diagnóstico y resolución de problemas mediante herramientas remotas. Gestión de tickets y configuración de equipos vía remoto",
    techs: null
  },
  {
    date: "Enero 2013 - Abril 2020",
    title: "KONECTA: Telemarketer (At. al cliente y Soporte técnico)",
    description: "Atención al cliente, gestión de reclamaciones y soporte general. Negociación y manejo de llamadas",
    techs: null
  }
]
const EXPERIENCEDEV = [
  {
    date: "Enero 2024 - Mayo 2024",
    title: "RST Argentina: (Prácticas Profesionales):",
    description: "A cargo del desarrollo del Backend para dos aplicaciones web para gestión de turnos médicos, chatbot y prescripción de recetas médicas",
    techs: [
      PythonIcon, DjangoIcon, JavascriptIcon, TypescriptIcon, ExpressIcon, SequelizeIcon, PostgreSQLIcon
    ]
  },
]

interface Props {
  programador: boolean
  soporte: boolean
}

const {programador, soporte} = Astro.props
---

<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">  
    {
      soporte && EXPERIENCESOPORTE.map((experienceItem) =>(
          <li class="mb-10 ms-4">
              <ExperienceItem {...experienceItem}/>
          </li>
      ))
    }
    {
      programador && EXPERIENCEDEV.map((experienceItem) =>(
          <li class="mb-10 ms-4">
              <ExperienceItem {...experienceItem}/>
          </li>
      ))
    }                
    
</ol>

